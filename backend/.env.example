NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase: copy these from your Supabase project settings.
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: only needed for privileged server-side jobs. Never expose this to the frontend.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: configure to enable live AI Mentor responses. Keep this key server-side only.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini
